# MISTRAL_API_KEY: Required for AI-powered analysis (claim checking, bot detection, comment authenticity, chatbot).
# Get a key at https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# MISTRAL_MODEL: Which Mistral model to use (default: mistral-small-latest).
# Options: mistral-small-latest (fast+cheap), mistral-medium-latest, mistral-large-latest (most capable)
MISTRAL_MODEL=mistral-small-latest

# SERVER_PORT: Port for the backend API server (default: 3001)
SERVER_PORT=3001
